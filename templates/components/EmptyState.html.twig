<div
    class="
        rounded-2xl
        border
        border-dashed
        border-slate-200

        p-10

        text-center
    "
>

    <h3
        class="
            text-lg
            font-semibold
        "
    >
        {{ title }}
    </h3>

    <p
        class="
            mt-2
            text-slate-500
        "
    >
        {{ message }}
    </p>

    {% if actionLabel and actionUrl %}

        <a
            href="{{ actionUrl }}"
            class="
                mt-6
                inline-flex

                rounded-xl

                bg-slate-900
                px-4
                py-2

                text-white
            "
        >
            {{ actionLabel }}
        </a>

    {% endif %}

</div>
