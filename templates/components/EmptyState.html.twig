<div
    class="
        rounded-2xl
        border
        border-dashed
        border-slate-200
        bg-slate-50/50
        dark:bg-slate-800
        px-6
        py-12

        text-center
    "
>

    <div
        class="
            mx-auto
            flex
            h-14
            w-14
            items-center
            justify-center
            bg-white
            dark:bg-slate-500
            rounded-2xl
            shadow-sm
        "
    >
        ✨
    </div>

    <h3
        class="
            mt-5
            text-lg
            font-semibold
            tracking-tight
            text-primary
        "
    >
        {{ title }}
    </h3>

    <p
        class="
            mx-auto
            mt-2
            max-w-md
            text-primary
            text-sm
            leading-6
        "
    >
        {{ message }}
    </p>

    {% if actionLabel and actionUrl %}

        <div class="mt-6">

            <a href="{{ actionUrl }}">
                <twig:Button>
                    {{ actionLabel }}
                </twig:Button>
            </a>

        </div>

    {% endif %}

</div>
