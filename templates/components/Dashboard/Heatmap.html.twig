<div{{ attributes }}>

    <twig:Card>

        <div class="space-y-6">

            <div>

                <div
                    class="
                        text-xs
                        uppercase
                        tracking-wide
                        text-slate-500
                    "
                >
                    Focus Activity
                </div>

                <h2
                    class="
                        mt-2
                        text-2xl
                        font-bold
                        tracking-tight
                    "
                >
                    Last 52 Weeks
                </h2>

            </div>

            <div
                class="
                    overflow-x-auto
                    pb-2
                "
            >

                <div
                    class="
                        inline-flex
                        gap-1
                    "
                >

                    {% for week in heatmap.weeks %}

                        <div
                            class="
                                grid
                                grid-rows-7
                                gap-1
                            "
                        >

                            {% for day in week.days %}

                                <div
                                    class="
                                        size-3
                                        rounded-sm
                                        transition
                                        hover:ring-2
                                        hover:ring-slate-400
                                        cursor-pointer
                                        {{ this.levelClass(day.level.value) }}
                                    "
                                    title="
{{ day.date|date('d/m/Y') }}
Focus: {{ day.focusMinutes }}m
Completed: {{ day.completedTasks }}
Interrupted: {{ day.interruptCount }}
                                    "
                                ></div>

                            {% endfor %}

                        </div>

                    {% endfor %}

                </div>

            </div>

            <div
                class="
                    flex
                    items-center
                    justify-end
                    gap-2
                    text-xs
                    text-slate-500
                "
            >

                <span>Less</span>

                {% for level in 0..4 %}

                    <div
                        class="
                            size-3
                            rounded-sm
                            {{ outerScope.this.levelClass(level) }}
                        "
                    ></div>

                {% endfor %}

                <span>More</span>

            </div>

        </div>

    </twig:Card>

</div>
