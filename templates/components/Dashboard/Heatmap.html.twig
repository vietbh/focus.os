<div{{ attributes }}>

    <twig:Card class="p-4 lg:p-5">

        <div class="space-y-4">

            <div class="flex items-start justify-between">

                <div>

                    <div class="flex items-center gap-2">

                        <span class="text-xl">🎯</span>

                        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">
                            Focus Consistency
                        </h2>

                    </div>

                    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                        Your focus activity over the last 52 weeks.
                    </p>

                </div>

                <div class="hidden text-right md:block">

                    <div class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
                        52W
                    </div>

                    <div class="text-xs uppercase tracking-wide text-slate-500">
                        Timeline
                    </div>

                </div>

            </div>

            <div
                class="w-full"
                style="
                    --cell-size: clamp(8px, 0.72vw, 14px);
                    --cell-gap: 2px;
                "
            >

                <div
                    class="flex w-full justify-between"
                    style="gap: var(--cell-gap);"
                >

                    {% for week in heatmap.weeks %}

                        <div
                            class="flex flex-col"
                            style="gap: var(--cell-gap);"
                        >

                            {% for day in week.days %}

                                <div
                                    class="
                                        rounded-[3px]
                                        transition
                                        duration-150
                                        hover:scale-125
                                        hover:ring-2
                                        hover:ring-slate-400
                                        hover:z-10
                                        cursor-pointer
                                        {{ outerScope.this.levelClass(day.level.value) }}
                                    "
                                    style="
                                        width: var(--cell-size);
                                        height: var(--cell-size);
                                    "
                                    title="{{ day.date|date('d M Y') }}

Focus: {{ day.focusMinutes }} minutes
Completed: {{ day.completedTasks }}
Interrupted: {{ day.interruptCount }}"
                                ></div>

                            {% endfor %}

                        </div>

                    {% endfor %}

                </div>

            </div>

            <div class="flex items-center justify-between">

                <div class="text-xs text-slate-500 dark:text-slate-400">
                    Consistency is more important than intensity.
                </div>

                <div class="flex items-center gap-2 text-xs text-slate-500">

                    <span>Less</span>

                    {% for level in 0..4 %}
                        <div
                            class="
                            size-3
                                rounded-[3px]
                                {{ outerScope.this.levelClass(level) }}
                            "

                        ></div>

                    {% endfor %}

                    <span>More</span>

                </div>

            </div>

        </div>

    </twig:Card>

</div>
