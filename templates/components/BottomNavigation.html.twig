<nav
    class="
        fixed
        bottom-0
        left-0
        right-0
        border-t
        border-slate-200

        dark:border-slate-500
        dark:bg-slate-950

        bg-white/95
        backdrop-blur

        lg:hidden
    "
>
    <div
        class="
            grid
            grid-cols-5
        "
    >

        {% for item in items %}

            {% set active = this.isActive(item.routePrefix) %}

            <a
                href="{{ url(item.route) }}"
                class="
                    flex
                    flex-col
                    items-center
                    justify-center

                    gap-1

                    py-3

                    transition
                "
            >

                <span
                    class="
                        h-1
                        w-8
                        rounded-full

                        {{
                    active
                    ? 'dark:bg-white bg-slate-900'
                    : 'bg-transparent'
                    }}
                    "
                ></span>

                <span
                    class="
                        text-xs

                        {{
                    active
                    ? 'font-semibold text-slate-900 dark:text-slate-100'
                    : 'text-slate-500'
                    }}
                    "
                >
                    {{ item.label }}
                </span>

            </a>

        {% endfor %}

    </div>
</nav>
