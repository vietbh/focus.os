<div{{ attributes }}>
    <!-- component HTML -->

    <div class="max-w-3xl">

        <twig:Card>

            {{ form_start(form,{
                attr:{
                    class: 'space-y-6'
                }
            }) }}
                {{ form_row(form.title) }}
                {{ form_row(form.areaId) }}
                <div class="">
                    <twig:Button type="button"
                        onclick="location.href='{{ url('area_list') }}'"
                    >+</twig:Button>
                </div>

                {{ form_rest(form) }}
                <div class="">
                    <twig:Button
                        data-action="live#action:prevent"
                        data-live-action-param="save"
                    >Create</twig:Button>

                    <twig:Button type="button"
                                 onclick="location.href='{{ url('task_list') }}'">Back</twig:Button>
                </div>
            {{ form_end(form) }}


