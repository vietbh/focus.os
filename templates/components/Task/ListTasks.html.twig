<div{{ attributes }}>
    <twig:Card>

        {% if pagination is empty %}

            <twig:EmptyState
                title="No tasks"
                message="Create your first task and start making progress."
                actionLabel="Create Task"
                actionUrl="{{ path('task_create') }}"
            />

        {% else %}

            <div
                class="
                    divide-y
                    divide-slate-100
                    dark:divide-zinc-800
                "
            >

                {% for task in pagination %}

                    <div id="task-{{ task.id }}">

                        <a
                            href="{{ path(
                                'task_detail',
                                { taskId: task.id }
                            ) }}"
                            class="
                                block
                                px-4
                                py-4

                                transition

                                hover:bg-slate-50
                                dark:hover:bg-zinc-900
                            "
                        >

                            <div
                                class="
                                    flex
                                    items-start
                                    justify-between
                                    gap-4
                                "
                            >

                                <div
                                    class="
                                        min-w-0
                                        flex-1
                                    "
                                >

                                    <div
                                        class="
                                            font-medium

                                            text-slate-900
                                            dark:text-zinc-100
                                        "
                                    >
                                        {{ task.title }}
                                    </div>

                                    {% if task.nextAction %}
                                        <div
                                            class="
                                                mt-1
                                                text-sm

                                                text-slate-500
                                                dark:text-zinc-400

                                                line-clamp-1
                                            "
                                        >
                                            {{ task.nextAction }}
                                        </div>
                                    {% endif %}

                                    {% if task.description %}
                                        <div
                                            class="
                                                mt-2
                                                text-sm

                                                text-slate-400
                                                dark:text-zinc-500

                                                line-clamp-2
                                            "
                                        >
                                            {{ task.description }}
                                        </div>
                                    {% endif %}

                                </div>

                                <span
                                    class="
                                        inline-flex
                                        shrink-0
                                        rounded-full

                                        px-3
                                        py-1

                                        text-xs
                                        font-medium

                                        {{ task.status.badgeClass }}
                                    "
                                >
                                    {{ task.status.label }}
                                </span>

                            </div>

                        </a>

                    </div>

                {% endfor %}

            </div>

        {% endif %}

    </twig:Card>

    <div class="mt-4">
        {{ knp_pagination_render(pagination) }}
    </div>

</div>
