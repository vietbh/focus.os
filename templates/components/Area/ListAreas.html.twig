<div{{ attributes }}>
    <!-- component HTML -->
    <twig:Card>

        {% if pagination is empty %}

            <twig:EmptyState
                title="No areas"
                message="Create your first area."
                actionLabel="Create Area"
                actionUrl="{{ path('area_create') }}"
            />

        {% else %}

            <div class="divide-y">

                {% for area in pagination %}
                    {% set taskNumbers = outerScope.this.taskNumbers(area.id) %}
                    <a
                        href="{{ path(
                            'area_edit',
                            {
                                areaId: area.id
                            }
                        ) }}"
                    >
                        <div
                            class="
                            flex
                            items-center
                            justify-between
                            py-4
                        "
                        >

                            <div>

                                <div
                                    class="
                                    font-medium
                                "
                                >
                                    {{ area.name }}
                                </div>

                                {% if area.goalId %}

                                    <div
                                        class="
                                        mt-1
                                        text-sm
                                        text-slate-500
                                    "
                                    >
                                        Goal Assigned
                                    </div>

                                {% endif %}

                            </div>

                            <twig:Badge label="{{ taskNumbers }} Tasks" />

                        </div>
                    </a>
                {% endfor %}

            </div>

        {% endif %}

    </twig:Card>

    <div class="mt-4">
        {{ knp_pagination_render(pagination) }}
    </div>

</div>
