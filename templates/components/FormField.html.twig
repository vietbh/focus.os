<div class="mb-3">

    {% if label %}
        <label class="form-label">
            {{ label }}
        </label>
    {% endif %}

    {% block content %}{% endblock %}

    {% if help %}
        <div class="form-text">
            {{ help }}
        </div>
    {% endif %}

    {% if error %}
        <div class="invalid-feedback d-block">
            {{ error }}
        </div>
    {% endif %}

</div>
