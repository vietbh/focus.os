<div
    id="{{ id }}"
    data-controller="sheet"
    {{ attributes }}
>

    <div
        data-sheet-target="backdrop"
        data-action="click->sheet#close"
        class="
            fixed
            inset-0
            z-40

            hidden

            bg-black/40
            backdrop-blur-sm
        "
    ></div>

    <div
        data-sheet-target="panel"
        class="
            fixed
            inset-x-0
            bottom-0
            z-50
            hidden
            rounded-t-3xl
            bg-white
            dark:bg-slate-900
            shadow-xl
        "
    >

        <div
            class="
                mx-auto
                mt-3
                mb-4

                h-1.5
                w-12

                rounded-full
                bg-slate-300
            "
        ></div>

        <div class="px-6 pb-6">

            <div
                class="
                    mb-6
                    flex
                    items-center
                    justify-between
                "
            >

                <h2
                    class="
                        text-lg
                        font-semibold
                    "
                >
                    {{ title }}
                </h2>

                <button
                    type="button"
                    data-sheet-dismiss
                >
                    ✕
                </button>

            </div>

            {% block content %}
            {% endblock %}

        </div>

    </div>

</div>
