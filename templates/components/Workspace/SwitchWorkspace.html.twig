<div {{ attributes }} class="relative mt-1">

    <a
        href="#"
        class="
            flex
            w-full
            items-center
            justify-between
            rounded-xl
            border
            border-slate-200
            bg-white
            px-4
            py-3
            text-left
            transition
            hover:border-primary-300
            hover:bg-primary-50
            dark:border-slate-700
            dark:bg-slate-900
            dark:hover:border-primary-500
        "
        data-action="live#action:prevent"
        data-live-action-param="toggle"
    >
        <div class="flex items-center gap-3">

            {% if currentWorkspace.icon %}
                <i class="{{ currentWorkspace.icon }}"></i>
            {% else %}
                <div
                    class="h-3 w-3 rounded-full"
                    style="background: {{ currentWorkspace.color ?: '#3b82f6' }}"
                ></div>
            {% endif %}

            <span class="font-medium">
                {{ currentWorkspace.name }}
            </span>
        </div>

        <svg
            xmlns="http://www.w3.org/2000/svg"
            class="
                h-4
                w-4
                transition-transform
                duration-200
                {{ expanded ? 'rotate-180' : '' }}
            "
            viewBox="0 0 24 24"
            stroke="currentColor"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"></path>
        </svg>
    </a>

    {% if expanded %}
        <div
            class="
                mt-2
                overflow-hidden
                rounded-xl
                border
                border-slate-200
                bg-white
                shadow-lg
                dark:border-slate-700
                dark:bg-slate-900
            "
        >

            {% for workspace in workspaces %}

                <button
                    type="button"
                    class="
                        flex
                        w-full
                        items-center
                        justify-between
                        px-4
                        py-3
                        text-left
                        transition
                        hover:bg-slate-50
                        dark:hover:bg-slate-800
                    "
                    data-action="live#action"
                    data-live-action-param="switch"
                    data-live-workspace-id-param="{{ workspace.id }}"
                >
                    <div class="flex items-center gap-3">

                        {% if workspace.icon %}
                            <i class="{{ workspace.icon }}"></i>
                        {% else %}
                            <div
                                class="h-3 w-3 rounded-full"
                                style="background: {{ workspace.color ?: '#3b82f6' }}"
                            ></div>
                        {% endif %}

                        <span>{{ workspace.name }}</span>
                    </div>

                    {% if workspace.id == currentWorkspace.id %}
                        <svg
                            class="h-4 w-4 text-primary-600"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                    {% endif %}
                </button>

            {% endfor %}

            <div class="border-t border-slate-200 dark:border-slate-700">

                <button
                    onclick="location.href='{{ url('workspace_list') }}'"
                    type="button"
                    class="
                        w-full
                        px-4
                        py-3
                        text-left
                        text-primary-600
                        transition
                        hover:bg-slate-50
                        dark:hover:bg-slate-800
                    "
                >
                    All Workspace
                </button>

            </div>

        </div>
    {% endif %}

</div>
