<div
    class="
        mb-8

        flex
        flex-col
        gap-4

        lg:flex-row
        lg:items-center
        lg:justify-between
    "
>

    <div>

        <h1
            class="
                text-3xl
                font-bold
                tracking-tight
            "
        >
            {{ title }}
        </h1>

        {% if subtitle %}

            <p
                class="
                    mt-2
                    text-slate-500
                "
            >
                {{ subtitle }}
            </p>

        {% endif %}

    </div>

    {% if actionLabel and actionUrl %}

        <a
            href="{{ actionUrl }}"
            class="
                inline-flex
                items-center

                rounded-xl

                bg-slate-900

                px-4
                py-2.5

                text-sm
                font-medium
                text-white
            "
        >
            {{ actionLabel }}
        </a>

    {% endif %}
    {% block content %}{% endblock %}
</div>
