{% set classes = {
    success: '
        bg-emerald-50
        text-emerald-700
        border-emerald-200
    ',
    error: '
        bg-rose-50
        text-rose-700
        border-rose-200
    ',
    warning: '
        bg-amber-50
        text-amber-700
        border-amber-200
    ',
    info: '
        bg-sky-50
        text-sky-700
        border-sky-200
    '
} %}
<div
    data-controller="toast"
    class="
        mb-4

        rounded-xl
        border

        p-4

        {{ classes[type] }}
    "
>
    {{ message }}
</div>
