<div
    {{ attributes }}
    data-controller="flash"
    data-flash-delay-value="4000"
    class="
        rounded-xl
        px-4
        py-3
        shadow-sm
        border
        transition-all
        duration-300
        {{ this.containerClass }}
    "
>
    <div class="flex items-start justify-between gap-3">
        <div class="text-sm font-medium">
            {{ message }}
        </div>

        <button
            type="button"
            data-action="flash#close"
            class="opacity-60 hover:opacity-100"
        >
            ✕
        </button>
    </div>
</div>
