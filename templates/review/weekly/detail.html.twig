{% extends 'base.html.twig' %}

{% block title %}
    Weekly Review
{% endblock %}

{% block body %}

    <twig:PageHeader
        title="Week of {{ review.weekStartDate|date('Y-m-d') }}"
        subtitle="Weekly Review"
    />
    {% include 'review/_navigation.html.twig' with {
        active: 'weekly'
    }  %}
    <div class="space-y-6">

        <twig:Card>

            <h2
                class="
                    mb-4
                    text-lg
                    font-semibold
                "
            >
                Achievements
            </h2>

            <div class="whitespace-pre-wrap">
                {{ review.achievements }}
            </div>

        </twig:Card>

        <twig:Card>

            <h2
                class="
                    mb-4
                    text-lg
                    font-semibold
                "
            >
                Lessons Learned
            </h2>

            <div class="whitespace-pre-wrap">
                {{ review.lessonsLearned }}
            </div>

        </twig:Card>

        <twig:Card>

            <h2
                class="
                    mb-4
                    text-lg
                    font-semibold
                "
            >
                Improvements
            </h2>

            <div class="whitespace-pre-wrap">
                {{ review.improvements }}
            </div>

        </twig:Card>

        <twig:Card>

            <h2
                class="
                    mb-4
                    text-lg
                    font-semibold
                "
            >
                Next Week Focus
            </h2>

            <div class="whitespace-pre-wrap">
                {{ review.nextWeekFocus }}
            </div>

        </twig:Card>

    </div>

{% endblock %}
