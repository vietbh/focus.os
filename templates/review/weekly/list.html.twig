{% extends 'base.html.twig' %}

{% block title %}
    Weekly Reviews
{% endblock %}

{% block body %}

    <twig:PageHeader
        title="Weekly Reviews"
        subtitle="Reflect on progress across the week."
    >
        <twig:Button
            onclick="location.href='{{ path('weekly_review_create') }}'"
        >
            Create Review Weekly
        </twig:Button>
    </twig:PageHeader>

    {% include 'review/_navigation.html.twig' with {
        active: reviewType
    } %}

    {% if reviews is empty %}

        <twig:EmptyState
            title="No Weekly Reviews"
            message="Create your first weekly reflection."
        >

            <twig:Button
                tag="a"
                href="{{ path('weekly_review_create') }}"
            >
                Create Weekly Review
            </twig:Button>

        </twig:EmptyState>

    {% else %}

        <div class="space-y-4">

            {% for review in reviews %}

                <twig:Card>

                    <div
                        class="
                            flex
                            items-start
                            justify-between
                            gap-4
                        "
                    >

                        <div class="min-w-0 flex-1">

                            <div
                                class="
                                    text-sm
                                    text-slate-500
                                "
                            >
                                Week
                            </div>

                            <div
                                class="
                                    mt-1
                                    text-lg
                                    font-semibold
                                "
                            >
                                {{ review.weekStartDate|date('M d, Y') }}
                            </div>

                            {% if review.nextWeekFocus is defined
                                and review.nextWeekFocus is not empty
                            %}

                                <div
                                    class="
                                        mt-3
                                        text-sm
                                        text-slate-600
                                    "
                                >
                                    {{ review.nextWeekFocus|slice(0, 120) }}

                                    {% if review.nextWeekFocus|length > 120 %}
                                        ...
                                    {% endif %}
                                </div>

                            {% endif %}

                        </div>

                        <twig:Button
                            tag="a"
                            href="{{ path(
                                'weekly_review_detail',
                                {
                                    weeklyReviewId: review.id
                                }
                            ) }}"
                            variant="secondary"
                        >
                            View
                        </twig:Button>

                    </div>

                </twig:Card>

            {% endfor %}

        </div>

    {% endif %}

{% endblock %}
