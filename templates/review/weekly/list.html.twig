{% extends 'base.html.twig' %}

{% block title %}
    Weekly Reviews
{% endblock %}

{% block body %}

    <twig:PageHeader
        title="Weekly Reviews"
        subtitle="Reflect on progress across the week."
    />

    <div class="mb-6">

        <a
            href="{{ path('weekly_review_create') }}"
            class="
                inline-flex
                rounded-lg
                bg-slate-900
                px-4
                py-2
                text-white
            "
        >
            Create Weekly Review
        </a>

    </div>

    <twig:Card>

        {% if reviews is empty %}

            <twig:EmptyState
                title="No weekly reviews"
                message="Create your first weekly review."
            />

        {% else %}

            <div class="divide-y">

                {% for review in reviews %}

                    <a
                        href="{{ path(
                            'weekly_review_detail',
                            {
                                weeklyReviewId: review.id
                            }
                        ) }}"
                        class="
                            block
                            py-4
                            hover:bg-slate-50
                        "
                    >

                        <div class="font-medium">
                            Week of
                            {{ review.weekStartDate|date('Y-m-d') }}
                        </div>

                    </a>

                {% endfor %}

            </div>

        {% endif %}

    </twig:Card>

{% endblock %}
