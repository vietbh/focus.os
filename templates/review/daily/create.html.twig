{% extends 'base.html.twig' %}

{% block title %}
    Daily Review
{% endblock %}

{% block body %}

    <twig:PageHeader
        title="Daily Review"
        subtitle="Reflect on today and prepare for tomorrow."
    />

    <form
        method="post"
        action="{{ path('daily_review_store') }}"
        class="space-y-6"
    >

        <input
            type="hidden"
            name="reviewDate"
            value="{{ 'now'|date('Y-m-d') }}"
        >

        <twig:Card>

            <h2
                class="
                    mb-4
                    text-lg
                    font-semibold
                "
            >
                Today's Progress
            </h2>

            <div
                class="
                    grid
                    gap-4
                    md:grid-cols-3
                "
            >

                <div>

                    <div
                        class="
                            text-sm
                            text-slate-500
                        "
                    >
                        Completed Tasks
                    </div>

                    <div
                        class="
                            mt-1
                            text-3xl
                            font-bold
                        "
                    >
                        {{ today.doneTasks }}
                    </div>

                </div>

                <div>

                    <div
                        class="
                            text-sm
                            text-slate-500
                        "
                    >
                        Interrupted Tasks
                    </div>

                    <div
                        class="
                            mt-1
                            text-3xl
                            font-bold
                        "
                    >
                        {{ today.interruptedTasks }}
                    </div>

                </div>

                <div>

                    <div
                        class="
                            text-sm
                            text-slate-500
                        "
                    >
                        Focus Time
                    </div>

                    <div
                        class="
                            mt-1
                            text-3xl
                            font-bold
                        "
                    >

                        {% if today.focusMinutes is defined %}

                            {{ (today.focusMinutes / 60)|round(1, 'floor') }}h
                            {{ today.focusMinutes % 60 }}m

                        {% else %}

                            —

                        {% endif %}

                    </div>

                </div>

            </div>

        </twig:Card>

        <twig:Card>

            <h2
                class="
                    mb-4
                    text-lg
                    font-semibold
                "
            >
                Reflection
            </h2>

            <div class="space-y-6">

                <div>

                    <label
                        class="
                            mb-2
                            block
                            text-sm
                            font-medium
                        "
                    >
                        Completed Work
                    </label>

                    <textarea
                        name="completedWork"
                        rows="4"
                        required
                        class="form-control"
                    >{{ suggestion.completedWork }}</textarea>

                </div>

                <div>

                    <label
                        class="
                            mb-2
                            block
                            text-sm
                            font-medium
                        "
                    >
                        Wins
                    </label>

                    <textarea
                        name="wins"
                        rows="4"
                        required
                        class="form-control"
                    >{{ suggestion.wins }}</textarea>

                </div>

                <div>

                    <label
                        class="
                            mb-2
                            block
                            text-sm
                            font-medium
                        "
                    >
                        Blockers
                    </label>

                    <textarea
                        name="blockers"
                        rows="4"
                        class="form-control"
                    >{{ suggestion.blockers }}</textarea>

                </div>

            </div>

        </twig:Card>

        <twig:Card>

            <h2
                class="
                    mb-4
                    text-lg
                    font-semibold
                "
            >
                Tomorrow
            </h2>

            <div>

                <label
                    class="
                        mb-2
                        block
                        text-sm
                        font-medium
                    "
                >
                    What should you focus on tomorrow?
                </label>

                <textarea
                    name="focusTomorrow"
                    rows="4"
                    required
                    class="form-control"
                >{{ suggestion.focusTomorrow }}</textarea>

            </div>

        </twig:Card>

        <div
            class="
                flex
                justify-end
            "
        >

            <twig:Button
                type="submit"
            >
                Complete Review
            </twig:Button>

        </div>

    </form>

{% endblock %}
