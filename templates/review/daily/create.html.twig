{% extends 'base.html.twig' %}

{% block title %}
    Daily Review
{% endblock %}

{% block body %}

    <twig:PageHeader
        title="Daily Review"
        subtitle="Close the day intentionally."
    />

    <twig:Card>

        <form
            method="post"
            action="{{ path('daily_review_store') }}"
            class="space-y-6"
        >

            <div>

                <label class="mb-2 block text-sm font-medium">
                    Date
                </label>

                <input
                    type="date"
                    name="reviewDate"
                    value="{{ 'now'|date('Y-m-d') }}"
                    required
                    class="
                        w-full
                        rounded-lg
                        border
                        px-4
                        py-3
                    "
                >

            </div>

            <div>

                <label class="mb-2 block text-sm font-medium">
                    Completed Work
                </label>

                <textarea
                    name="completedWork"
                    rows="5"
                    required
                    class="
                        w-full
                        rounded-lg
                        border
                        px-4
                        py-3
                    "
                ></textarea>

            </div>

            <div>

                <label class="mb-2 block text-sm font-medium">
                    Wins
                </label>

                <textarea
                    name="wins"
                    rows="5"
                    required
                    class="
                        w-full
                        rounded-lg
                        border
                        px-4
                        py-3
                    "
                ></textarea>

            </div>

            <div>

                <label class="mb-2 block text-sm font-medium">
                    Blockers
                </label>

                <textarea
                    name="blockers"
                    rows="5"
                    class="
                        w-full
                        rounded-lg
                        border
                        px-4
                        py-3
                    "
                ></textarea>

            </div>

            <div>

                <label class="mb-2 block text-sm font-medium">
                    Focus Tomorrow
                </label>

                <textarea
                    name="focusTomorrow"
                    rows="5"
                    required
                    class="
                        w-full
                        rounded-lg
                        border
                        px-4
                        py-3
                    "
                ></textarea>

            </div>

            <button
                type="submit"
                class="
                    rounded-lg
                    bg-slate-900
                    px-4
                    py-2
                    text-white
                "
            >
                Save Review
            </button>

        </form>

    </twig:Card>

{% endblock %}
