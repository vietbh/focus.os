{% extends 'base.html.twig' %}

{% block title %}
    Daily Review
{% endblock %}

{% block body %}

    <twig:PageHeader
        title="{{ review.reviewDate|date('Y-m-d') }}"
        subtitle="Daily Review"
    />

    <div class="space-y-6">

        <twig:Card>

            <h2
                class="
                    mb-4
                    text-lg
                    font-semibold
                "
            >
                Completed Work
            </h2>

            <div class="whitespace-pre-wrap">
                {{ review.completedWork }}
            </div>

        </twig:Card>

        <twig:Card>

            <h2
                class="
                    mb-4
                    text-lg
                    font-semibold
                "
            >
                Wins
            </h2>

            <div class="whitespace-pre-wrap">
                {{ review.wins }}
            </div>

        </twig:Card>

        {% if review.blockers %}

            <twig:Card>

                <h2
                    class="
                        mb-4
                        text-lg
                        font-semibold
                    "
                >
                    Blockers
                </h2>

                <div class="whitespace-pre-wrap">
                    {{ review.blockers }}
                </div>

            </twig:Card>

        {% endif %}

        <twig:Card>

            <h2
                class="
                    mb-4
                    text-lg
                    font-semibold
                "
            >
                Focus Tomorrow
            </h2>

            <div class="whitespace-pre-wrap">
                {{ review.focusTomorrow }}
            </div>

        </twig:Card>

    </div>

{% endblock %}
