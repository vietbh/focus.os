{% extends 'base.html.twig' %}

{% block title %}
    Daily Reviews
{% endblock %}

{% block body %}

    <twig:PageHeader
        title="Daily Reviews"
        subtitle="Reflect and improve every day."
    />
    {% include 'review/_navigation.html.twig' with {
        active: 'daily'
    } %}
    <div class="mb-6">

        <a
            href="{{ path('daily_review_create') }}"
            class="
                inline-flex
                rounded-lg
                bg-slate-900
                px-4
                py-2
                text-white
            "
        >
            Create Review
        </a>

    </div>

    <twig:Card>

        {% if reviews is empty %}

            <twig:EmptyState
                title="No reviews"
                message="Create your first daily review."
            />

        {% else %}

            <div class="divide-y">

                {% for review in reviews %}

                    <a
                        href="{{ path(
                            'daily_review_detail',
                            {
                                dailyReviewId: review.id
                            }
                        ) }}"
                        class="
                            block
                            py-4
                            hover:bg-slate-50
                        "
                    >

                        <div class="font-medium">
                            {{ review.reviewDate|date('Y-m-d') }}
                        </div>

                    </a>

                {% endfor %}

            </div>

        {% endif %}

    </twig:Card>

{% endblock %}
