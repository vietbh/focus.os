{% extends 'base.html.twig' %}

{% block title %}
    Monthly Reviews
{% endblock %}

{% block body %}

    <twig:PageHeader
        title="Monthly Reviews"
        subtitle="Reflect on long-term progress and direction."
    >
        <twig:Button
            onclick="location.href='{{ path('monthly_review_create') }}'"
        >
            Create Review Monthly
        </twig:Button>
    </twig:PageHeader>

    {% include 'review/_navigation.html.twig' with {
        active: 'monthly'
    }  %}

    <twig:Card>

        {% if reviews is empty %}

            <twig:EmptyState
                title="No monthly reviews"
                message="Create your first monthly review."
            />

        {% else %}

            <div class="divide-y">

                {% for review in reviews %}

                    <a
                        href="{{ path(
                            'monthly_review_detail',
                            {
                                monthlyReviewId: review.id
                            }
                        ) }}"
                        class="
                            block
                            py-4
                            hover:bg-slate-50
                        "
                    >

                        <div class="font-medium">
                            {{ review.month|date('Y-m') }}
                        </div>

                    </a>

                {% endfor %}

            </div>

        {% endif %}

    </twig:Card>

{% endblock %}
