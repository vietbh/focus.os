{% extends 'base.html.twig' %}

{% block title %}
    Monthly Review
{% endblock %}

{% block body %}

    <twig:PageHeader
        title="{{ review.month|date('Y-m') }}"
        subtitle="Monthly Review"
    />
    {% include 'review/_navigation.html.twig' with {
        active: 'monthly'
    } %}
    <div class="space-y-6">

        <twig:Card>

            <h2 class="mb-4 text-lg font-semibold">
                Major Achievements
            </h2>

            <div class="whitespace-pre-wrap">
                {{ review.majorAchievements }}
            </div>

        </twig:Card>

        <twig:Card>

            <h2 class="mb-4 text-lg font-semibold">
                Goal Progress
            </h2>

            <div class="whitespace-pre-wrap">
                {{ review.goalProgress }}
            </div>

        </twig:Card>

        <twig:Card>

            <h2 class="mb-4 text-lg font-semibold">
                Major Challenges
            </h2>

            <div class="whitespace-pre-wrap">
                {{ review.majorChallenges }}
            </div>

        </twig:Card>

        <twig:Card>

            <h2 class="mb-4 text-lg font-semibold">
                Lessons Learned
            </h2>

            <div class="whitespace-pre-wrap">
                {{ review.lessonsLearned }}
            </div>

        </twig:Card>

        <twig:Card>

            <h2 class="mb-4 text-lg font-semibold">
                Next Month Focus
            </h2>

            <div class="whitespace-pre-wrap">
                {{ review.nextMonthFocus }}
            </div>

        </twig:Card>

    </div>

{% endblock %}
