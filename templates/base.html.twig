<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title>
        {% block title %}
            Focus OS
        {% endblock %}
    </title>

    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}
            {{ importmap('app') }}
        {% endblock %}
    {% endblock %}

</head>

<body
    class="
        min-h-screen
        bg-slate-50
        text-slate-900
    "
>

<div class="flex min-h-screen">

    <aside
        class="
            hidden
            w-72
            border-r
            border-slate-200
            bg-white

            lg:flex
            lg:flex-col
        "
    >

        <div class="p-6">

            <div
                class="
                    text-xs
                    uppercase
                    tracking-[0.2em]
                    text-slate-400
                "
            >
                Personal OS
            </div>

            <div
                class="
                    mt-2
                    text-2xl
                    font-bold
                "
            >
                Focus OS
            </div>

        </div>

        <twig:SidebarNavigation />

        <div
            class="
                border-t
                border-slate-200
                p-4
            "
        >

            <div
                class="
                    flex
                    items-center
                    gap-3
                "
            >

                <div
                    class="
                        flex
                        h-10
                        w-10
                        items-center
                        justify-center

                        rounded-full
                        bg-slate-100

                        text-sm
                        font-semibold
                    "
                >
                    {{ app.user.email|first|upper }}
                </div>

                <div
                    class="
                        truncate
                        text-sm
                    "
                >
                    {{ app.user.email }}
                </div>

            </div>

            <a
                href="{{ path('identity_logout') }}"
                class="
                    mt-4
                    block
                    text-sm
                    text-slate-500
                    hover:text-slate-900
                "
            >
                Sign out
            </a>

        </div>
{#        <twig:UserMenu />#}
    </aside>

    <main
        class="
            flex-1
            overflow-y-auto
        "
    >

        <header
            class="
                sticky
                top-0
                z-20

                border-b
                border-slate-200

                bg-white/80
                backdrop-blur

                lg:hidden
            "
        >

            <div
                class="
                    flex
                    items-center
                    justify-between

                    px-4
                    py-4
                "
            >

                <div>

                    <div
                        class="
                            text-xs
                            uppercase
                            tracking-wide
                            text-slate-400
                        "
                    >
                        Focus OS
                    </div>

                    <div
                        class="
                            font-semibold
                        "
                    >
                        Today
                    </div>

                </div>

{#                <div>213</div>#}

            </div>
        </header>

{#        <div#}
{#            id="flash-container"#}
{#            class="#}
{#                mx-auto#}
{#                max-w-6xl#}
{#                px-6#}
{#                pt-6#}
{#            "#}
{#        >#}

{#            {% for message in app.flashes('success') %}#}

{#                <twig:Flash#}
{#                    type="success"#}
{#                    :message="message"#}
{#                />#}

{#            {% endfor %}#}

{#            {% for message in app.flashes('error') %}#}

{#                <twig:Flash#}
{#                    type="error"#}
{#                    :message="message"#}
{#                />#}

{#            {% endfor %}#}

{#        </div>#}
        <div id="flash-container">

            {% for message in app.flashes('success') %}

                <twig:Flash
                    type="success"
                    :message="message"
                />

            {% endfor %}

        </div>

        <div
            class="
                mx-auto
                max-w-6xl

                p-6
                pb-24

                lg:p-8
            "
        >

            {% block body %}
            {% endblock %}

        </div>

    </main>

</div>

<twig:BottomNavigation />
<twig:CommandPalette />
</body>
</html>
