<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <title>
        {% block title %}
            Focus OS
        {% endblock %}
    </title>

    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}
            {{ importmap('app') }}
        {% endblock %}
    {% endblock %}
</head>

<body class="min-h-screen bg-slate-50 text-slate-900">

<div class="flex min-h-screen">

    <aside
        class="
            hidden
            w-56
            border-r
            border-slate-200
            bg-white
            lg:flex
            lg:flex-col
        "
    >

        <div class="px-6 py-8">

            <div
                class="
                    text-xs
                    uppercase
                    tracking-[0.2em]
                    text-slate-400
                "
            >
                Personal OS
            </div>

            <h1
                class="
                    mt-1
                    text-2xl
                    font-bold
                "
            >
                Focus OS
            </h1>

        </div>

        <twig:DesktopNavigation />

        <div
            class="
                border-t
                border-slate-200
                p-4
            "
        >

            <div
                class="
                    truncate
                    text-sm
                    text-slate-600
                "
            >
                {{ app.user.email }}
            </div>

            <a
                href="{{ path('identity_logout') }}"
                class="
                    mt-3
                    block
                    text-sm
                    text-slate-500
                    hover:text-slate-900
                "
            >
                Sign out
            </a>

        </div>

    </aside>

    <main
        class="
            flex-1
            overflow-y-auto
        "
    >

        <twig:MobileNavigation />

        <div
            class="
                mx-auto
                max-w-6xl
                p-6
                lg:p-8
            "
        >

            {% for message in app.flashes('success') %}

                <div
                    class="
                        mb-4
                        rounded-xl
                        bg-emerald-50
                        p-4
                        text-emerald-700
                    "
                >
                    {{ message }}
                </div>

            {% endfor %}

            {% for message in app.flashes('error') %}

                <div
                    class="
                        mb-4
                        rounded-xl
                        bg-rose-50
                        p-4
                        text-rose-700
                    "
                >
                    {{ message }}
                </div>

            {% endfor %}

            {% block body %}
            {% endblock %}

        </div>

    </main>

</div>

</body>
</html>
