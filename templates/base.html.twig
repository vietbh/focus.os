<!DOCTYPE html>
<html lang="en"
      data-theme="{{ current_theme() }}"
      class="{{ current_theme() == 'dark' ? 'dark' : '' }}"
>

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title>
        {% block title %}
            Focus OS
        {% endblock %}
    </title>
    <link
        rel="icon"
        href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Ccircle cx='32' cy='32' r='26' fill='none' stroke='%232563eb' stroke-width='6'/%3E%3Ccircle cx='32' cy='32' r='8' fill='%232563eb'/%3E%3C/svg%3E"
    />
    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}
            {{ importmap('app') }}
        {% endblock %}
    {% endblock %}
    {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
    {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
    {% endif %}
</head>

<body
    data-controller="theme notification"
    data-notification-vapid-key-value="{{ app_web_push_public_key }}"
    data-notification-subscribe-url-value="{{ url('notification_push_subscribe') }}"
    class="
        min-h-screen

        bg-slate-50
        text-slate-900

        dark:bg-slate-950
        dark:text-slate-100
    "
>

<div class="flex min-h-screen">

    <aside
        class="
            hidden
            w-72

            border-r
            border-slate-200
            bg-white

            dark:border-slate-800
            dark:bg-slate-900

            lg:flex
            lg:flex-col
        "
    >

        <div class="p-6">

            <div
                class="
                    text-xs
                    uppercase
                    tracking-[0.2em]
                    text-slate-400
                    dark:text-slate-500
                "
            >
                Personal OS
            </div>

            <div
                class="
                    mt-2
                    text-2xl
                    font-bold
                "
            >
                Focus OS
            </div>

        </div>

        <twig:SidebarNavigation />


        <twig:UserMenu />
    </aside>

    <main
        class="
            flex-1
            overflow-y-auto
        "
    >

        <header
            class="
                sticky
                top-0
                z-20

                border-b
                border-slate-200
                bg-white

                dark:border-slate-800
                dark:bg-slate-900
                backdrop-blur

                lg:hidden
            "
        >

            <div
                class="
                    flex
                    items-center
                    justify-between

                    px-4
                    py-4
                "
            >

                <div>

                    <div
                        class="
                            text-xs
                            uppercase
                            tracking-wide
                            text-slate-400
                        "
                    >
                        Focus OS
                    </div>

                    <div
                        class="
                            font-semibold
                        "
                    >
                        Today
                    </div>

                </div>

            </div>
        </header>
        <div
            id="flash-container"
            class="
        fixed
        top-4
        right-4
        z-50
        flex
        flex-col
        gap-2
        w-80
        max-w-[calc(100vw-2rem)]
    "
        >
            {% for message in app.flashes('success') %}

                <twig:Flash
                    type="success"
                    :message="message"
                />

            {% endfor %}

        </div>

        <div
            class="
                mx-auto
                max-w-6xl

                p-6
                pb-24

                lg:p-8
            "
        >

            {% block body %}
            {% endblock %}

        </div>

    </main>

</div>
<twig:BottomNavigation />

<twig:Notification:Toast/>
<twig:QuickCreateButton />

<twig:Sheet
    id="quick-create"
    title="Quick Create"
>

    <div class="space-y-6">

        {# Primary Action #}
        <a
            href="{{ path('task_create') }}"
            class="
                block
                rounded-3xl
                bg-slate-900
                p-5
                text-white
                dark:bg-slate-800
            "
        >
            <div class="text-lg font-semibold">
                ⚡ Create Task
            </div>

            <div
                class="
                    mt-1
                    text-sm
                    text-slate-300
                "
            >
                Start working on something now.
            </div>
        </a>

        <div class="space-y-2">

            <div
                class="
                    flex
                    items-center
                    justify-between

                    rounded-2xl
                    border
                    border-slate-200

                    p-4
                "
            >
                <a
                    href="{{ path('inbox_list') }}"
                    class="font-medium"
                >
                    📥 Inbox
                </a>

                {{ _self.buttonPlusCreate('inbox_list') }}

            </div>

            <div
                class="
                    flex
                    items-center
                    justify-between

                    rounded-2xl
                    border
                    border-slate-200

                    p-4
                "
            >
                <a
                    href="{{ path('note_list') }}"
                    class="font-medium"
                >
                    📝 Notes
                </a>

                {{ _self.buttonPlusCreate('note_create') }}

            </div>

            <div
                class="
                    flex
                    items-center
                    justify-between

                    rounded-2xl
                    border
                    border-slate-200

                    p-4
                "
            >
                <a
                    href="{{ path('goal_list') }}"
                    class="font-medium"
                >
                    🎯 Goals
                </a>

                {{ _self.buttonPlusCreate('goal_create') }}

            </div>

            <div
                class="
                    flex
                    items-center
                    justify-between

                    rounded-2xl
                    border
                    border-slate-200

                    p-4
                "
            >
                <a
                    href="{{ path('area_list') }}"
                    class="font-medium"
                >
                    🗂 Areas
                </a>

                {{ _self.buttonPlusCreate('area_create') }}

            </div>

        </div>

    </div>
    {% macro buttonPlusCreate(route) %}
        <a
            href="{{ path(route) }}"
            class="
                        rounded-full
                        bg-slate-100
                        dark:bg-slate-800
                        px-3
                        py-1
                        text-sm
                    "
        >
            {{ ux_icon('heroicons:plus') }}
        </a>
    {% endmacro %}
</twig:Sheet>

<twig:CommandPalette />
</body>
</html>
