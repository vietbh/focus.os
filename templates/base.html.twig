<!DOCTYPE html>
<html lang="en"
      data-theme="{{ current_theme() }}"
      class="{{ current_theme() == 'dark' ? 'dark' : '' }}"
>

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title>
        {% block title %}
            Focus OS
        {% endblock %}
    </title>

    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}
            {{ importmap('app') }}
        {% endblock %}
    {% endblock %}

</head>

<body
    data-controller="theme"
    class="
        min-h-screen

        bg-slate-50
        text-slate-900

        dark:bg-slate-950
        dark:text-slate-100
    "
>

<div class="flex min-h-screen">

    <aside
        class="
            hidden
            w-72

            border-r
            border-slate-200
            bg-white

            dark:border-slate-800
            dark:bg-slate-900

            lg:flex
            lg:flex-col
        "
    >

        <div class="p-6">

            <div
                class="
                    text-xs
                    uppercase
                    tracking-[0.2em]
                    text-slate-400
                    dark:text-slate-500
                "
            >
                Personal OS
            </div>

            <div
                class="
                    mt-2
                    text-2xl
                    font-bold
                "
            >
                Focus OS
            </div>

        </div>

        <twig:SidebarNavigation />

        <div
            class="
                border-t
                border-slate-200
                p-4
            "
        >

            <div
                class="
                    flex
                    items-center
                    gap-3
                "
            >

                <div
                    class="
                        flex
                        h-10
                        w-10
                        items-center
                        justify-center

                        rounded-full
                        bg-slate-100
                        dark:bg-slate-800

                        text-sm
                        font-semibold
                    "
                >
                    {{ app.user.email|first|upper }}
                </div>

                <div
                    class="
                        truncate
                        text-sm
                    "
                >
                    {{ app.user.email }}
                </div>

            </div>

            <a
                href="{{ path('identity_logout') }}"
                class="
                    mt-4
                    block
                    text-sm
                    text-slate-500
                    hover:text-slate-900

                    dark:text-slate-400
                    dark:hover:text-slate-100
                "
            >
                Sign out
            </a>

        </div>
{#        <twig:UserMenu />#}
    </aside>

    <main
        class="
            flex-1
            overflow-y-auto
        "
    >

        <header
            class="
                sticky
                top-0
                z-20

                border-b
                border-slate-200
                bg-white

                dark:border-slate-800
                dark:bg-slate-900
                backdrop-blur

                lg:hidden
            "
        >

            <div
                class="
                    flex
                    items-center
                    justify-between

                    px-4
                    py-4
                "
            >

                <div>

                    <div
                        class="
                            text-xs
                            uppercase
                            tracking-wide
                            text-slate-400
                        "
                    >
                        Focus OS
                    </div>

                    <div
                        class="
                            font-semibold
                        "
                    >
                        Today
                    </div>

                </div>

            </div>
        </header>
        <div
            id="flash-container"
            class="
        fixed
        top-4
        right-4
        z-50
        flex
        flex-col
        gap-2
        w-80
        max-w-[calc(100vw-2rem)]
    "
        >
            {% for message in app.flashes('success') %}

                <twig:Flash
                    type="success"
                    :message="message"
                />

            {% endfor %}

        </div>

        <div
            class="
                mx-auto
                max-w-6xl

                p-6
                pb-24

                lg:p-8
            "
        >

            {% block body %}
            {% endblock %}

        </div>

    </main>

</div>
<twig:BottomNavigation />

<twig:QuickCreateButton />

<twig:Sheet
    id="quick-create"
    title="Quick Create"
>

    <div class="space-y-6">

        {# Primary Action #}
        <a
            href="{{ path('task_create') }}"
            class="
                block
                rounded-3xl
                bg-slate-900
                p-5
                text-white
                dark:bg-slate-800
            "
        >
            <div class="text-lg font-semibold">
                ⚡ Create Task
            </div>

            <div
                class="
                    mt-1
                    text-sm
                    text-slate-300
                "
            >
                Start working on something now.
            </div>
        </a>

        <div class="space-y-2">

            <div
                class="
                    flex
                    items-center
                    justify-between

                    rounded-2xl
                    border
                    border-slate-200

                    p-4
                "
            >
                <a
                    href="{{ path('inbox_list') }}"
                    class="font-medium"
                >
                    📥 Inbox
                </a>

                {{ _self.buttonPlusCreate('inbox_list') }}

            </div>

            <div
                class="
                    flex
                    items-center
                    justify-between

                    rounded-2xl
                    border
                    border-slate-200

                    p-4
                "
            >
                <a
                    href="{{ path('note_list') }}"
                    class="font-medium"
                >
                    📝 Notes
                </a>

                {{ _self.buttonPlusCreate('note_create') }}

            </div>

{#            <div#}
{#                class="#}
{#                    flex#}
{#                    items-center#}
{#                    justify-between#}

{#                    rounded-2xl#}
{#                    border#}
{#                    border-slate-200#}

{#                    p-4#}
{#                "#}
{#            >#}
{#                <a#}
{#                    href="{{ path('goal_list') }}"#}
{#                    class="font-medium"#}
{#                >#}
{#                    🎯 Goals#}
{#                </a>#}

{#                <a#}
{#                    href="{{ path('goal_create') }}"#}
{#                    class="#}
{#                        rounded-full#}
{#                        bg-slate-100#}
{#                        px-3#}
{#                        py-1#}
{#                        text-sm#}
{#                    "#}
{#                >#}
{#                    +#}
{#                </a>#}
{#            </div>#}

            <div
                class="
                    flex
                    items-center
                    justify-between

                    rounded-2xl
                    border
                    border-slate-200

                    p-4
                "
            >
                <a
                    href="{{ path('area_list') }}"
                    class="font-medium"
                >
                    🗂 Areas
                </a>

                {{ _self.buttonPlusCreate('area_create') }}

            </div>

        </div>

    </div>
    {% macro buttonPlusCreate(route) %}
        <a
            href="{{ path(route) }}"
            class="
                        rounded-full
                        bg-slate-100
                        dark:bg-slate-800
                        px-3
                        py-1
                        text-sm
                    "
        >
            +
        </a>
    {% endmacro %}
</twig:Sheet>

<twig:CommandPalette />
</body>
</html>
