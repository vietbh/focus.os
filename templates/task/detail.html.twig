{% extends 'base.html.twig' %}

{% block title %}
    {{ task.title }}
{% endblock %}

{% block body %}
    <twig:PageHeader
        :title="task.title"
        :subtitle="task.status.value"
    />

    <div class="grid gap-6 lg:grid-cols-3">

        <div class="lg:col-span-2">

            <twig:Card>

                <h2
                    class="
                        mb-4
                        text-lg
                        font-semibold
                    "
                >
                    Next Action
                </h2>

                <p
                    class="
                        text-lg
                        text-slate-700
                    "
                >
                    {{ task.nextAction }}
                </p>

            </twig:Card>

            {% if task.description %}

                <div class="mt-6">

                    <twig:Card>

                        <h2
                            class="
                                mb-4
                                text-lg
                                font-semibold
                            "
                        >
                            Description
                        </h2>

                        <div class="whitespace-pre-wrap">
                            {{ task.description }}
                        </div>

                    </twig:Card>

                </div>

            {% endif %}

        </div>

        <div class="space-y-6">

            <twig:Card>

                <h2
                    class="
                        mb-4
                        text-lg
                        font-semibold
                    "
                >
                    Status
                </h2>

                <div class="space-y-2">

                    <div>
                        {{ task.status.value }}
                    </div>

                    <div
                        class="
                            text-sm
                            text-slate-500
                        "
                    >
                        Estimate:
                        {{ task.estimatedMinutes }}
                        min
                    </div>

                </div>

            </twig:Card>

            <twig:Card>

                <h2
                    class="
                        mb-4
                        text-lg
                        font-semibold
                    "
                >
                    Actions
                </h2>

                <div class="space-y-2">

                    <twig:Card>

                        <h2
                            class="
            mb-4
            text-lg
            font-semibold
        "
                        >
                            Actions
                        </h2>

                        <turbo-frame
                            id="task-actions"
                        >

                            {% include 'task/_actions.html.twig' %}

                        </turbo-frame>

                    </twig:Card>

                    {% if task.status.value == 'DOING' %}

                        <form
                            method="post"
                            action="{{ path(
                                'task_interrupt',
                                {
                                    taskId: task.id
                                }
                            ) }}"
                        >
                            <button
                                type="submit"
                                class="
                                    w-full
                                    rounded-lg
                                    border
                                    px-4
                                    py-2
                                "
                            >
                                Interrupt
                            </button>
                        </form>

                        <form
                            method="post"
                            action="{{ path(
                                'task_complete',
                                {
                                    taskId: task.id
                                }
                            ) }}"
                        >
                            <button
                                type="submit"
                                class="
                                    w-full
                                    rounded-lg
                                    bg-slate-900
                                    px-4
                                    py-2
                                    text-white
                                "
                            >
                                Complete
                            </button>
                        </form>

                    {% endif %}

                    {% if task.status.value == 'INTERRUPTED' %}

                        <form
                            method="post"
                            action="{{ path(
                                'task_resume',
                                {
                                    taskId: task.id
                                }
                            ) }}"
                        >
                            <button
                                type="submit"
                                class="
                                    w-full
                                    rounded-lg
                                    bg-slate-900
                                    px-4
                                    py-2
                                    text-white
                                "
                            >
                                Resume
                            </button>
                        </form>

                    {% endif %}

                </div>

            </twig:Card>

        </div>

    </div>

{% endblock %}
