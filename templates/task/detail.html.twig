{% extends 'base.html.twig' %}

{% block title %}
    {{ task.title }}
{% endblock %}

{% block body %}

    <twig:PageHeader
        :title="task.title"
        subtitle="Task Detail"
    />

    <div
        class="
            grid
            gap-6

            lg:grid-cols-3
        "
    >

        <div
            class="
                space-y-6

                lg:col-span-2
            "
        >

            <twig:Card>

                <twig:Section
                    title="Overview"
                >

                    <div class="space-y-6">

                        <div>

                            <div
                                class="
                                    text-xs
                                    uppercase
                                    tracking-wide
                                    text-slate-500
                                "
                            >
                                Title
                            </div>

                            <div
                                class="
                                    mt-2
                                    text-2xl
                                    font-semibold
                                "
                            >
                                {{ task.title }}
                            </div>

                        </div>

                        {% if task.description %}

                            <div>

                                <div
                                    class="
                                        text-xs
                                        uppercase
                                        tracking-wide
                                        text-slate-500
                                    "
                                >
                                    Description
                                </div>

                                <div
                                    class="
                                        mt-2
                                        whitespace-pre-wrap
                                        text-slate-700
                                    "
                                >
                                    {{ task.description }}
                                </div>

                            </div>

                        {% endif %}

                    </div>

                </twig:Section>

            </twig:Card>

            <twig:Card>

                <twig:Section
                    title="Execution"
                >

                    <div class="space-y-6">

                        {% if task.nextAction %}

                            <div>

                                <div
                                    class="
                                        text-xs
                                        uppercase
                                        tracking-wide
                                        text-slate-500
                                    "
                                >
                                    Next Action
                                </div>

                                <div
                                    class="
                                        mt-2
                                        text-lg
                                        text-slate-900
                                    "
                                >
                                    {{ task.nextAction }}
                                </div>

                            </div>

                        {% endif %}

                        {% if task.estimatedMinutes %}

                            <div>

                                <div
                                    class="
                                        text-xs
                                        uppercase
                                        tracking-wide
                                        text-slate-500
                                    "
                                >
                                    Estimated Time
                                </div>

                                <div
                                    class="
                                        mt-2
                                        text-slate-900
                                    "
                                >
                                    {{ task.estimatedMinutes }}
                                    minutes
                                </div>

                            </div>

                        {% endif %}

                    </div>

                </twig:Section>

            </twig:Card>

        </div>

        <div class="space-y-6">

            <twig:Card>

                <twig:Section
                    title="Status"
                >

                    <turbo-frame
                        id="task-status"
                    >

                        {% include
                            'task/_status.html.twig'
                        %}

                    </turbo-frame>

                </twig:Section>

            </twig:Card>

            <twig:Card>

                <twig:Section
                    title="Actions"
                >

                    <turbo-frame
                        id="task-actions"
                    >

                        {% include 'task/_actions.html.twig' %}

                    </turbo-frame>

                </twig:Section>

            </twig:Card>

            <twig:Card>

                <twig:Section
                    title="Navigation"
                >

                    <a
                        href="{{ path('task_list') }}"
                        class="
                            text-sm
                            text-slate-600
                            hover:text-slate-900
                        "
                    >
                        ← Back to Tasks
                    </a>

                </twig:Section>

            </twig:Card>

        </div>

    </div>

{% endblock %}
