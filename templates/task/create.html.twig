{% extends 'base.html.twig' %}

{% block title %}
    Create Task
{% endblock %}

{% block body %}

    <twig:PageHeader
        title="Create Task"
        subtitle="Define the next meaningful action."
    />

    <div class="max-w-3xl">

        <twig:Card>

            <form
                method="post"
                action="{{ path('task_store') }}"
                class="space-y-6"
            >

                <twig:FormField
                    label="Title"
                    required="true"
                    hint="What needs to be done?"
                >

                    <input
                        type="text"
                        name="title"
                        required

                        class="
                            w-full

                            rounded-xl
                            border
                            border-slate-200

                            px-4
                            py-3

                            focus:border-slate-400
                            focus:outline-none
                        "
                    >

                </twig:FormField>

                <twig:FormField
                    label="Area"
                    required="true"
                    hint="What area?"
                >
                    <select class="w-full
                            rounded-xl
                            border
                            border-slate-200
                            px-4
                            py-3
                            focus:border-slate-400
                            focus:outline-none"
                        name="areaId"
                    >
                        {% for area in areas %}
                            <option value="{{ area.id }}">{{ area.name }}</option>
                        {% endfor %}
                    </select>

                </twig:FormField>

                <twig:FormField
                    label="Description"
                    hint="Optional context or notes."
                >

                    <textarea
                        name="description"
                        rows="5"

                        class="
                            w-full

                            rounded-xl
                            border
                            border-slate-200

                            px-4
                            py-3

                            focus:border-slate-400
                            focus:outline-none
                        "
                    ></textarea>

                </twig:FormField>

                <twig:FormField
                    label="Next Action"
                    required="true"
                    hint="The very next physical action."
                >

                    <input
                        type="text"
                        name="nextAction"
                        required

                        class="
                            w-full

                            rounded-xl
                            border
                            border-slate-200

                            px-4
                            py-3

                            focus:border-slate-400
                            focus:outline-none
                        "
                    >

                </twig:FormField>

                <twig:FormField
                    label="Estimated Minutes"
                    hint="How long will this task take?"
                >

                    <input
                        type="number"
                        name="estimatedMinutes"
                        min="1"

                        class="
                            w-full

                            rounded-xl
                            border
                            border-slate-200

                            px-4
                            py-3

                            focus:border-slate-400
                            focus:outline-none
                        "
                    >

                </twig:FormField>
                <div
                    class="
                        flex
                        flex-col
                        gap-3

                        sm:flex-row
                    "
                >

                    <twig:Button
                        type="submit"
                    >
                        Create Task
                    </twig:Button>

                    <a
                        href="{{ path('task_list') }}"
                        class="
                            inline-flex
                            items-center
                            justify-center

                            rounded-xl

                            border
                            border-slate-200

                            px-4
                            py-2.5

                            text-sm
                            font-medium

                            hover:bg-slate-50
                        "
                    >
                        Cancel
                    </a>

                </div>

            </form>

        </twig:Card>

    </div>

{% endblock %}
