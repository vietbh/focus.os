{% extends 'base.html.twig' %}

{% block title %}
    Create Task
{% endblock %}

{% block body %}

    <twig:PageHeader
        title="Create Task"
        subtitle="Define the next actionable work item."
    />

    <twig:Card>

        <form
            method="post"
            action="{{ path('task_store') }}"
            class="space-y-6"
        >

            <div>

                <label
                    class="
                        mb-2
                        block
                        text-sm
                        font-medium
                    "
                >
                    Title
                </label>

                <input
                    type="text"
                    name="title"
                    required
                    class="
                        w-full
                        rounded-lg
                        border
                        px-4
                        py-3
                    "
                >

            </div>

            <div>

                <label
                    class="
                        mb-2
                        block
                        text-sm
                        font-medium
                    "
                >
                    Area
                </label>

                <select
                    name="areaId"
                    required
                    class="
                        w-full
                        rounded-lg
                        border
                        px-4
                        py-3
                    "
                >

                    {% for area in areas %}

                        <option value="{{ area.id }}">
                            {{ area.name }}
                        </option>

                    {% endfor %}

                </select>

            </div>

            <div>

                <label
                    class="
                        mb-2
                        block
                        text-sm
                        font-medium
                    "
                >
                    Next Action
                </label>

                <input
                    type="text"
                    name="nextAction"
                    required
                    class="
                        w-full
                        rounded-lg
                        border
                        px-4
                        py-3
                    "
                >

            </div>

            <div>

                <label
                    class="
                        mb-2
                        block
                        text-sm
                        font-medium
                    "
                >
                    Estimated Minutes
                </label>

                <input
                    type="number"
                    name="estimatedMinutes"
                    min="1"
                    required
                    class="
                        w-full
                        rounded-lg
                        border
                        px-4
                        py-3
                    "
                >

            </div>

            <div>

                <label
                    class="
                        mb-2
                        block
                        text-sm
                        font-medium
                    "
                >
                    Description
                </label>

                <textarea
                    name="description"
                    rows="6"
                    class="
                        w-full
                        rounded-lg
                        border
                        px-4
                        py-3
                    "
                ></textarea>

            </div>

            <div class="flex gap-3">

                <button
                    type="submit"
                    class="
                        rounded-lg
                        bg-slate-900
                        px-4
                        py-2
                        text-white
                    "
                >
                    Create Task
                </button>

                <a
                    href="{{ path('task_list') }}"
                    class="
                        rounded-lg
                        border
                        px-4
                        py-2
                    "
                >
                    Cancel
                </a>

            </div>

        </form>

    </twig:Card>

{% endblock %}
