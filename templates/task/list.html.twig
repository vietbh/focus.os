{% extends 'base.html.twig' %}

{% block title %}
    Tasks
{% endblock %}

{% block body %}

    <twig:PageHeader
        title="Tasks"
        subtitle="Manage and execute your work."
        actionLabel="Create Task"
        actionUrl="{{ path('task_create') }}"
    />

    <twig:Card>

        {% if tasks is empty %}

            <twig:EmptyState
                title="No tasks"
                message="Create your first task and start making progress."
                actionLabel="Create Task"
                actionUrl="{{ path('task_create') }}"
            />

        {% else %}

            <div class="divide-y divide-slate-100">

                {% for task in tasks %}

                    <div
                        id="task-{{ task.id }}"
                    >

                        <a
                            href="{{ path(
                                'task_detail',
                                {
                                    taskId: task.id
                                }
                            ) }}"
                            class="
                                block
                                px-4
                                py-4
                                transition
                                hover:bg-slate-50
                            "
                        >

                            <div
                                class="
                                    flex
                                    items-start
                                    justify-between
                                    gap-4
                                "
                            >

                                <div
                                    class="
                                        min-w-0
                                        flex-1
                                    "
                                >

                                    <div
                                        class="
                                            font-medium
                                            text-slate-900
                                        "
                                    >
                                        {{ task.title }}
                                    </div>

                                    {% if task.nextAction %}

                                        <div
                                            class="
                                                mt-1
                                                text-sm
                                                text-slate-500
                                                line-clamp-1
                                            "
                                        >
                                            {{ task.nextAction }}
                                        </div>

                                    {% endif %}

                                    {% if task.description %}

                                        <div
                                            class="
                                                mt-2
                                                text-sm
                                                text-slate-400
                                                line-clamp-2
                                            "
                                        >
                                            {{ task.description }}
                                        </div>

                                    {% endif %}

                                </div>

                                <span
                                    class="
                                        inline-flex
                                        shrink-0
                                        rounded-full

                                        px-3
                                        py-1

                                        text-xs
                                        font-medium

                                        {{ task.status.badgeClass }}
                                    "
                                >
                                    {{ task.status.label }}
                                </span>

                            </div>

                        </a>

                    </div>

                {% endfor %}

            </div>

        {% endif %}

    </twig:Card>

{% endblock %}
