{% extends 'base.html.twig' %}

{% block title %}
    Tasks
{% endblock %}

{% block body %}

    <twig:PageHeader
        title="Tasks"
        subtitle="Manage and execute your work."
    />

    <div class="mb-6">
        <a
            href="{{ path('task_create') }}"
            class="
                inline-flex
                items-center
                rounded-lg
                bg-slate-900
                px-4
                py-2
                text-sm
                font-medium
                text-white
            "
        >
            Create Task
        </a>
    </div>

    {% if currentTask %}

        <div class="mb-6">

            <twig:Card>

                <div class="flex items-start justify-between gap-6">

                    <div>

                        <div
                            class="
                                text-xs
                                uppercase
                                tracking-wide
                                text-slate-500
                            "
                        >
                            Current Task
                        </div>

                        <h2
                            class="
                                mt-2
                                text-2xl
                                font-bold
                            "
                        >
                            {{ currentTask.title }}
                        </h2>

                        <p
                            class="
                                mt-2
                                text-slate-600
                            "
                        >
                            {{ currentTask.nextAction }}
                        </p>

                    </div>

                    <div class="flex gap-2">

                        <form
                            method="post"
                            action="{{ path(
                                'task_interrupt',
                                {
                                    taskId: currentTask.id
                                }
                            ) }}"
                        >
                            <button
                                type="submit"
                                class="
                                    rounded-lg
                                    border
                                    px-4
                                    py-2
                                "
                            >
                                Interrupt
                            </button>
                        </form>

                        <form
                            method="post"
                            action="{{ path(
                                'task_complete',
                                {
                                    taskId: currentTask.id
                                }
                            ) }}"
                        >
                            <button
                                type="submit"
                                class="
                                    rounded-lg
                                    bg-slate-900
                                    px-4
                                    py-2
                                    text-white
                                "
                            >
                                Complete
                            </button>
                        </form>

                    </div>

                </div>

            </twig:Card>

        </div>

    {% endif %}

    <twig:Card>

        <h2
            class="
                mb-6
                text-lg
                font-semibold
            "
        >
            All Tasks
        </h2>

        {% if tasks is empty %}

            <twig:EmptyState
                title="No tasks"
                message="Create your first task."
            />

        {% else %}

            <div class="divide-y">

                {% for task in tasks %}

                    <div
                        class="
                            flex
                            items-center
                            justify-between
                            py-4
                        "
                    >

                        <div>

                            <a
                                href="{{ path(
                                    'task_detail',
                                    {
                                        taskId: task.id
                                    }
                                ) }}"
                                class="
                                    font-medium
                                    hover:underline
                                "
                            >
                                {{ task.title }}
                            </a>

                            <div
                                class="
                                    mt-1
                                    text-sm
                                    text-slate-500
                                "
                            >
                                {{ task.status.value }}
                                ·
                                {{ task.estimatedMinutes }} min
                            </div>

                        </div>

                        <div class="flex gap-2">

                            {% if task.status.value == 'TODO' %}

                                <form
                                    method="post"
                                    action="{{ path(
                                        'task_start',
                                        {
                                            taskId: task.id
                                        }
                                    ) }}"
                                >
                                    <button
                                        type="submit"
                                        class="
                                            rounded-lg
                                            bg-slate-900
                                            px-3
                                            py-2
                                            text-white
                                        "
                                    >
                                        Start
                                    </button>
                                </form>

                            {% endif %}

                            {% if task.status.value == 'INTERRUPTED' %}

                                <form
                                    method="post"
                                    action="{{ path(
                                        'task_resume',
                                        {
                                            taskId: task.id
                                        }
                                    ) }}"
                                >
                                    <button
                                        type="submit"
                                        class="
                                            rounded-lg
                                            bg-slate-900
                                            px-3
                                            py-2
                                            text-white
                                        "
                                    >
                                        Resume
                                    </button>
                                </form>

                            {% endif %}

                        </div>

                    </div>

                {% endfor %}

            </div>

        {% endif %}

    </twig:Card>

{% endblock %}
