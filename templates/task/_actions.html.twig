<div class="space-y-3">

    {% if task.canStart %}

        <form
            method="post"
            action="{{ path(
                'task_start',
                {
                    taskId: task.id
                }
            ) }}"
        >

            <twig:Button
                type="submit"
                fullWidth="true"
            >
                Start Task
            </twig:Button>

        </form>

    {% endif %}

    {% if task.canInterrupt %}

        <form
            method="post"
            action="{{ path(
                'task_interrupt',
                {
                    taskId: task.id
                }
            ) }}"
        >

            <twig:Button
                type="submit"
                variant="secondary"
                fullWidth="true"
            >
                Interrupt Task
            </twig:Button>

        </form>

    {% endif %}

    {% if task.canResume %}

        <form
            method="post"
            action="{{ path(
                'task_resume',
                {
                    taskId: task.id
                }
            ) }}"
        >

            <twig:Button
                type="submit"
                fullWidth="true"
            >
                Resume Task
            </twig:Button>

        </form>

    {% endif %}

    {% if task.canComplete %}

        <form
            method="post"
            action="{{ path(
                'task_complete',
                {
                    taskId: task.id
                }
            ) }}"
        >

            <twig:Button
                type="submit"
                fullWidth="true"
            >
                Complete Task
            </twig:Button>

        </form>

    {% endif %}

    {% if task.status.isDone %}

        <div
            class="
                rounded-xl
                border
                border-emerald-200

                bg-emerald-50

                p-4

                text-sm
                text-emerald-700
            "
        >
            Task completed successfully.
        </div>

    {% endif %}

</div>
