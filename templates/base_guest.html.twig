<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title>
        {% block title %}
            Focus OS
        {% endblock %}
    </title>

    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}
            {{ importmap('app') }}
        {% endblock %}
    {% endblock %}

</head>

<body
    class="
        min-h-screen
        bg-slate-50
        text-slate-900
    "
>

<div
    class="
        grid
        min-h-screen
        lg:grid-cols-2
    "
>

    <div
        class="
            hidden
            border-r
            border-slate-200
            bg-white
            lg:flex
            lg:flex-col
            lg:justify-between
            lg:p-16
        "
    >

        <div>

            <div
                class="
                    inline-flex
                    rounded-full
                    border
                    border-slate-200
                    px-3
                    py-1
                    text-xs
                    font-medium
                    text-slate-600
                "
            >
                Focus OS
            </div>

            <h1
                class="
                    mt-8
                    text-6xl
                    font-bold
                    tracking-tight
                "
            >
                Your Personal
                Operating System
            </h1>

            <p
                class="
                    mt-6
                    max-w-md
                    text-lg
                    text-slate-600
                "
            >
                Capture ideas.
                Organize work.
                Execute intentionally.
                Review consistently.
            </p>

        </div>

        <div
            class="
                grid
                grid-cols-2
                gap-4
            "
        >

            <div class="rounded-2xl bg-slate-100 p-4">
                Goals
            </div>

            <div class="rounded-2xl bg-slate-100 p-4">
                Tasks
            </div>

            <div class="rounded-2xl bg-slate-100 p-4">
                Notes
            </div>

            <div class="rounded-2xl bg-slate-100 p-4">
                Reviews
            </div>

        </div>

    </div>

    <main
        class="
            flex
            items-center
            justify-center
            px-6
            py-12
        "
    >

        {% block body %}
        {% endblock %}

    </main>

</div>

</body>
</html>
