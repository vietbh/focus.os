{% extends 'base_guest.html.twig' %}

{% block title %}
    Login
{% endblock %}

{% block body %}

    <div
        class="
            w-full
            max-w-md
            rounded-2xl
            bg-white
            p-8
            shadow-sm
        "
    >

        <div class="text-center">

            <h2
                class="
                    text-2xl
                    font-bold
                "
            >
                Welcome back
            </h2>

            <p
                class="
                    mt-2
                    text-sm
                    text-slate-500
                "
            >
                Continue with your Google account.
            </p>

        </div>

        <div class="mt-8">

            <a
                href="{{ path('identity_google_connect') }}"
                class="
                    flex
                    items-center
                    justify-center
                    rounded-xl
                    border
                    px-4
                    py-3
                    font-medium
                    hover:bg-slate-50
                "
            >
                Continue with Google
            </a>

        </div>

    </div>

{% endblock %}
