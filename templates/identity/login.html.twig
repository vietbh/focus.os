{% extends 'base_guest.html.twig' %}

{% block title %}
    Login
{% endblock %}

{% block body %}

    <div
        class="
        w-full
        max-w-md
    "
    >

        <div
            class="
            rounded-3xl
            border
            border-slate-200
            bg-white
            p-8
            shadow-sm
        "
        >

            <div class="text-center">

                <h1
                    class="
                    text-3xl
                    font-bold
                "
                >
                    Focus OS
                </h1>

                <p
                    class="
                    mt-3
                    text-sm
                    text-slate-500
                "
                >
                    Continue with your Google account.
                </p>

            </div>

            <div class="mt-8">

                <a
                    href="{{ path('identity_google_connect') }}"
                    class="
                    flex
                    w-full
                    items-center
                    justify-center

                    rounded-xl
                    border
                    border-slate-200

                    px-4
                    py-3

                    text-sm
                    font-medium

                    hover:bg-slate-50
                "
                >
                    Continue with Google
                </a>

            </div>

        </div>

    </div>

{% endblock %}
