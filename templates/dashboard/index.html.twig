{% extends 'base.html.twig' %}

{% block title %}
    Today
{% endblock %}

{% block body %}

    <twig:PageHeader
        title="Today"
        subtitle="Focus on what matters most."
    />

    <div class="space-y-6">

        <div class="grid gap-6 lg:grid-cols-3">

            <div class="lg:col-span-2">

                {% if snapshot.currentTask %}

                    <twig:Card>

                        <div class="space-y-6">

                            <div>

                                <div
                                    class="
                                        text-xs
                                        uppercase
                                        tracking-wide
                                        text-slate-500
                                    "
                                >
                                    Current Task
                                </div>

                                <h2
                                    class="
                                        mt-2
                                        text-2xl
                                        font-bold
                                    "
                                >
                                    {{ snapshot.currentTask.title }}
                                </h2>

                            </div>

                            <div>

                                <div
                                    class="
                                        text-xs
                                        uppercase
                                        tracking-wide
                                        text-slate-500
                                    "
                                >
                                    Next Action
                                </div>

                                <div
                                    class="
                                        mt-2
                                        text-lg
                                    "
                                >
                                    {{ snapshot.currentTask.nextAction }}
                                </div>

                            </div>

                            <div class="flex gap-3">

                                <a
                                    href="{{ path(
                                        'task_detail',
                                        {
                                            taskId: snapshot.currentTask.id
                                        }
                                    ) }}"
                                    class="
                                        rounded-lg
                                        bg-slate-900
                                        px-4
                                        py-2
                                        text-white
                                    "
                                >
                                    Continue
                                </a>

                            </div>

                        </div>

                    </twig:Card>

                {% else %}

                    <twig:EmptyState
                        title="No active task"
                        message="Choose a task and start working."
                    />

                {% endif %}

            </div>

            <div>

                <twig:Card>

                    <h2
                        class="
                            mb-4
                            text-lg
                            font-semibold
                        "
                    >
                        Daily Review
                    </h2>

                    {% if snapshot.review.reviewCompletedToday %}

                        <div
                            class="
                                rounded-lg
                                bg-emerald-50
                                p-3
                                text-emerald-700
                            "
                        >
                            ✓ Reviewed today
                        </div>

                    {% else %}

                        <a
                            href="{{ path('daily_review_create') }}"
                            class="
                                inline-flex
                                rounded-lg
                                bg-slate-900
                                px-4
                                py-2
                                text-white
                            "
                        >
                            Create Review
                        </a>

                    {% endif %}

                </twig:Card>

            </div>

        </div>

        <twig:Card>

            <h2
                class="
                    mb-6
                    text-lg
                    font-semibold
                "
            >
                Daily Summary
            </h2>

            <div class="grid gap-6 md:grid-cols-3">

                <div>

                    <div
                        class="
                            text-3xl
                            font-bold
                        "
                    >
                        {{ snapshot.overview.inboxCount }}
                    </div>

                    <div
                        class="
                            mt-1
                            text-sm
                            text-slate-500
                        "
                    >
                        Inbox
                    </div>

                </div>

                <div>

                    <div
                        class="
                            text-3xl
                            font-bold
                        "
                    >
                        {{ snapshot.today.doneTasks }}
                    </div>

                    <div
                        class="
                            mt-1
                            text-sm
                            text-slate-500
                        "
                    >
                        Done Today
                    </div>

                </div>

                <div>

                    <div
                        class="
                            text-3xl
                            font-bold
                        "
                    >
                        {{ snapshot.today.interruptedTasks }}
                    </div>

                    <div
                        class="
                            mt-1
                            text-sm
                            text-slate-500
                        "
                    >
                        Interrupted
                    </div>

                </div>

            </div>

        </twig:Card>

    </div>

{% endblock %}
