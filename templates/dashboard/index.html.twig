{% extends 'base.html.twig' %}

{% block body %}

    <div class="space-y-6">

        {# Current Focus #}
        <twig:Dashboard:CurrentTask :currentTask="snapshot.currentTask"/>

        {# Action Center #}
        <twig:Dashboard:ReviewStatus :review="snapshot.review" />


        {# Today's Progress #}
        <twig:Dashboard:TodaySummary :today="snapshot.today" />

        {# Overview #}
        <twig:Dashboard:Overview :overview="snapshot.overview" />

        <twig:Dashboard:GoalList :goals="snapshot.activeGoals" />

        <twig:Dashboard:Heatmap
            :heatmap="snapshot.statistics.heatmap"
        />

    </div>

{% endblock %}
