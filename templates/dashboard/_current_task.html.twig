<twig:Card>
    {% if snapshot.currentTask %}

        <div class="space-y-6">

            <div>

                <div
                    class="
                        text-xs
                        uppercase
                        tracking-wide
                        text-slate-500
                    "
                >
                    Current Task
                </div>

                <h2
                    class="
                        mt-2
                        text-2xl
                        font-bold
                    "
                >
                    {{ snapshot.currentTask.title }}
                </h2>

            </div>

            <div>

                <div
                    class="
                        text-xs
                        uppercase
                        tracking-wide
                        text-slate-500
                    "
                >
                    Next Action
                </div>

                <div
                    class="
                        mt-2
                        text-lg
                    "
                >
                    {{ snapshot.currentTask.nextAction }}
                </div>

            </div>
            <div>

                <div
                    class="
                        text-xs
                        uppercase
                        tracking-wide
                        text-slate-500
                    "
                >
                    Status
                </div>

                <div
                    class="
                        mt-2
                        text-lg
                    "
                >
                    <span
                        class="
                            inline-flex
                            rounded-full

                            px-3
                            py-1

                            text-sm
                            font-medium

                            {{ snapshot.currentTask.status.badgeClass }}
                        "
                                        >
                        {{ snapshot.currentTask.status.label }}
                    </span>
                </div>

            </div>

            <a
                href="{{ path(
                    'task_detail',
                    {
                        taskId: snapshot.currentTask.id
                    }
                ) }}"
            >
                <twig:Button>
                    Continue
                </twig:Button>
            </a>

        </div>

    {% else %}

        <twig:EmptyState
            title="No active task"
            message="Choose a task and start working."
        />

    {% endif %}

</twig:Card>
