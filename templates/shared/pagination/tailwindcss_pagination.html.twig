{% if pageCount > 1 %}
    <div class="mt-6">
        <div
            class="
            flex
            flex-col
            gap-3

            sm:flex-row
            sm:items-center
            sm:justify-between
        "
        >
            <div
                class="
                text-center
                sm:text-left

                text-sm
                text-zinc-500
                dark:text-zinc-400
            "
            >
                Page {{ current }}
                of {{ pageCount }}
            </div>

            <div
                class="
                flex
                items-center
                justify-center
                gap-2
            "
            >
                {% if previous is defined %}
                    <button
                        data-action="live#action"
                        data-live-action-param="gotoPage"
                        data-live-page-param="{{ previous }}"
                        class="
                        rounded-xl
                        border

                        border-zinc-200
                        dark:border-zinc-800

                        bg-white
                        dark:bg-zinc-900

                        px-4
                        py-2

                        text-sm
                        text-zinc-700
                        dark:text-zinc-200

                        hover:bg-zinc-50
                        dark:hover:bg-zinc-800
                    "
                    >
                        ← Previous
                    </button>
                {% endif %}

                <div
                    class="
                    hidden
                    md:flex
                    items-center
                    gap-1
                "
                >
                    {% for page in pagesInRange %}
                        {% if page == current %}
                            <span
                                class="
                                h-10
                                min-w-10

                                flex
                                items-center
                                justify-center

                                rounded-xl

                                bg-zinc-900
                                dark:bg-zinc-100

                                text-white
                                dark:text-zinc-900

                                font-semibold
                            "
                            >
                            {{ page }}
                        </span>
                        {% else %}
                            <button
                                data-action="live#action"
                                data-live-action-param="gotoPage"
                                data-live-page-param="{{ page }}"
                                class="
                                h-10
                                min-w-10

                                rounded-xl

                                border
                                border-zinc-200
                                dark:border-zinc-800

                                bg-white
                                dark:bg-zinc-900

                                text-zinc-700
                                dark:text-zinc-200

                                hover:bg-zinc-50
                                dark:hover:bg-zinc-800
                            "
                            >
                                {{ page }}
                            </button>
                        {% endif %}
                    {% endfor %}
                </div>

                {% if next is defined %}
                    <button
                        data-action="live#action"
                        data-live-action-param="gotoPage"
                        data-live-page-param="{{ next }}"
                        class="
                        rounded-xl
                        border

                        border-zinc-200
                        dark:border-zinc-800

                        bg-white
                        dark:bg-zinc-900

                        px-4
                        py-2

                        text-sm
                        text-zinc-700
                        dark:text-zinc-200

                        hover:bg-zinc-50
                        dark:hover:bg-zinc-800
                    "
                    >
                        Next →
                    </button>
                {% endif %}
            </div>
        </div>
    </div>
{% endif %}
