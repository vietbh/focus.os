{% extends 'base.html.twig' %}

{% block title %}
    Goals
{% endblock %}

{% block body %}

    <twig:PageHeader
        title="Goals"
        subtitle="Define outcomes, not tasks."
    />

    <div class="mb-6">
        <twig:Button
            onclick="location.href='{{ path('goal_create') }}'"
        >
            Create Goal
        </twig:Button>
    </div>

    <twig:Card>

        {% if goals is empty %}

            <twig:EmptyState
                title="No goals"
                message="Create your first goal."
            />

        {% else %}

            <div class="divide-y divide-slate-200">

                {% for goal in goals %}

                    <a
                        href="{{ path(
                            'goal_detail',
                            {
                                goalId: goal.id
                            }
                        ) }}"
                        class="
                            block
                            py-4
                            transition
                            hover:bg-slate-50
                        "
                    >

                        <div
                            class="
                                flex
                                items-center
                                justify-between
                                gap-4
                            "
                        >

                            <div class="min-w-0">

                                <div
                                    class="
                                        truncate
                                        font-medium
                                    "
                                >
                                    {{ goal.title }}
                                </div>

                            </div>

                            <div
                                class="
                                    shrink-0
                                    text-sm
                                    text-slate-500
                                "
                            >
                                {{ goal.status.value }}
                            </div>

                        </div>

                    </a>

                {% endfor %}

            </div>

        {% endif %}

    </twig:Card>

{% endblock %}
