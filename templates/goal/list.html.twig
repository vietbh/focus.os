{% extends 'base.html.twig' %}

{% block body %}
    <div class="space-y-8">

        <twig:PageHeader
            title="Goals"
            subtitle="Define outcomes, not tasks."
        >
            <twig:Button
                onclick="location.href='{{ path('goal_create') }}'"
            >
                Create Goal
            </twig:Button>
        </twig:PageHeader>

        {% if goals is empty %}

            <twig:EmptyState
                title="No goals yet"
                message="Create your first goal and start making progress."
            >
                <twig:Button
                    href="{{ path('goal_create') }}"
                >
                    Create Goal
                </twig:Button>
            </twig:EmptyState>

        {% else %}

            <div class="grid gap-4">

                {% for goal in goals %}
                    <a
                        href="{{ path(
                            'goal_detail',
                            {
                                goalId: goal.id.value
                            }
                        ) }}"
                    >
                        <twig:Card>
                            <div
                                class="
                                flex
                                items-start
                                justify-between
                                gap-4

                            "
                            >
                                <div class="min-w-0 flex-1">

                                    <h2
                                        class="
                                        truncate
                                        text-lg
                                        font-semibold
                                        text-slate-900
                                        dark:text-slate-100
                                    "
                                    >
                                        {{ goal.title }}
                                    </h2>

                                    {% if goal.description %}
                                        <p
                                            class="
                                            mt-2
                                            line-clamp-2
                                            text-sm
                                            text-slate-600
                                            dark:text-slate-100
                                        "
                                        >
                                            {{ goal.description }}
                                        </p>
                                    {% endif %}

                                    <div
                                        class="
                                        mt-4
                                        flex
                                        flex-wrap
                                        items-center
                                        gap-4
                                        text-sm
                                        text-slate-500
                                        dark:text-slate-100
                                    "
                                    >

                                        {% if goal.targetDate %}
                                            <span>
                                            📅
                                            {{ goal.targetDate|date('d M Y') }}
                                        </span>
                                        {% else %}
                                            <span>
                                            No target date
                                        </span>
                                        {% endif %}

                                    </div>

                                </div>

                                <div
                                    class="
                                    shrink-0
                                "
                                >
                                    <twig:Badge
                                        :variant="goal.status.badgeClass"
                                        :label="goal.status.label"
                                    />

                                </div>

                            </div>
                        </twig:Card>

                    </a>

                {% endfor %}

            </div>

        {% endif %}

    </div>
{% endblock %}
