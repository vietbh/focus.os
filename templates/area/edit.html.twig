{% extends 'base.html.twig' %}

{% block title %}
    Edit Area
{% endblock %}

{% block body %}

    <twig:PageHeader
        title="Edit Area"
        subtitle="Update area settings."
    />

    <div class="grid gap-6 lg:grid-cols-3">

        <div class="lg:col-span-2">

            <twig:Card>

                <form
                    method="post"
                    action="{{ path(
                        'area_update',
                        {
                            areaId: area.id.value
                        }
                    ) }}"
                    class="space-y-6"
                >

                    <div>

                        <label
                            class="
                                mb-2
                                block
                                text-sm
                                font-medium
                            "
                        >
                            Name
                        </label>

                        <input
                            type="text"
                            name="name"
                            value="{{ area.name }}"
                            required
                            class="
                                w-full
                                rounded-lg
                                border
                                px-4
                                py-3
                            "
                        >

                    </div>

                    <div>

                        <label
                            class="
                                mb-2
                                block
                                text-sm
                                font-medium
                            "
                        >
                            Goal
                        </label>

                        <select
                            name="goalId"
                            class="
                                w-full
                                rounded-lg
                                border
                                px-4
                                py-3
                            "
                        >

                            <option value="">
                                No Goal
                            </option>

                            {% for goal in goals %}

                                <option
                                    value="{{ goal.id }}"
                                    {% if area.goalId and area.goalId.value == goal.id.value %}
                                        selected
                                    {% endif %}
                                >
                                    {{ goal.title }}
                                </option>

                            {% endfor %}

                        </select>

                    </div>

                    <button
                        type="submit"
                        class="
                            rounded-lg
                            bg-slate-900
                            px-4
                            py-2
                            text-white
                        "
                    >
                        Save Area
                    </button>

                </form>

            </twig:Card>

        </div>

        <div>

            <twig:Card>

                <h2
                    class="
                        mb-4
                        text-lg
                        font-semibold
                    "
                >
                    Danger Zone
                </h2>

                <form
                    method="post"
                    action="{{ path(
                        'area_delete',
                        {
                            areaId: area.id
                        }
                    ) }}"
                >

                    <button
                        type="submit"
                        class="
                            w-full
                            rounded-lg
                            border
                            px-4
                            py-2
                        "
                    >
                        Delete Area
                    </button>

                </form>

            </twig:Card>

        </div>

    </div>

{% endblock %}
